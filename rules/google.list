# The suffixes below match Gemini web/iOS, AI Studio, NotebookLM, Flow and Labs.
# Match the YouTube list first for YouTube media and API hosts.
DOMAIN-SUFFIX,ai.google.dev
DOMAIN-SUFFIX,ai.studio
DOMAIN-SUFFIX,deepmind.com
DOMAIN-SUFFIX,flowmusic.app
DOMAIN-SUFFIX,gemini-api-docs-mcp.dev

# Antigravity website, OAuth, model APIs and downloads match the shared Google suffixes.
# The CLI, desktop app and IDE update manifests also use these dedicated Cloud Run hosts.
DOMAIN,antigravity-cli-auto-updater-974169037036.us-central1.run.app
DOMAIN,antigravity-hub-auto-updater-974169037036.us-central1.run.app
DOMAIN,antigravity-ide-auto-updater-974169037036.us-central1.run.app

